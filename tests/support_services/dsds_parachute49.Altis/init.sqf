if (!hasInterface) exitWith {};
[] spawn {
 waitUntil {sleep 0.1;!isNull player && {time>2}};sleep 3;
 private _pass=0;private _fail=0;
 private _assert={params [["_ok",false],"_label"];if (_ok) then {_pass=_pass+1;} else {_fail=_fail+1;};diag_log format ["[PARACHUTE49] %1: %2",["FAIL","PASS"] select _ok,_label];};
 teamPlayer=side group player;DSDS_jobs=createHashMap;DSDS_jobSequence=0;
 private _start=getPosATL player;
 flagX=createVehicle ["FlagPole_F",_start,[],0,"NONE"];
 private _g=createGroup teamPlayer;private _npc=_g createUnit ["I_G_Soldier_F",player getPos [10,0],[],0,"NONE"];
 _npc disableAI "PATH";_npc setBehaviour "CARELESS";
 private _dest=[objNull] call DSDS_fnc_travelDestinations;
 [player in _dest,"human player included in destination candidates"] call _assert;
 [!(_npc in _dest),"NPC excluded from destination candidates"] call _assert;
 player setVariable ["DSDS_travelCombatAt",serverTime];
 [player in ([objNull] call DSDS_fnc_travelDestinations),"temporarily unsafe human remains visible"] call _assert;
 player setVariable ["DSDS_travelCombatAt",-1000];
 ["TRAVEL"] call DSDS_fnc_openTerminal;sleep 0.1;
 [lbSize ((findDisplay 88400) displayCtrl 1750)==0,"travel UI never lists NPCs when no other humans connected"] call _assert;
 closeDialog 0;
 private _carrier=if (isClass (configFile >> "CfgVehicles" >> "RHS_C130J")) then {"RHS_C130J"} else {"B_Heli_Transport_01_F"};
 diag_log format ["[PARACHUTE49] Carrier: %1",_carrier];
 private _plane=createVehicle [_carrier,_start vectorAdd [0,0,120],[],0,"FLY"];
 _plane setPosATL (_start vectorAdd [0,0,120]);_plane enableSimulationGlobal false;_plane allowDamage false;
 player setVariable ["owner",player];player setVariable ["moneyX",1000,true];player allowDamage true;
 if (backpack player=="") then {player addBackpack "B_AssaultPack_blk";};
 player addItemToBackpack "DSDS_Zyn";
 private _bag=[backpack player,backpackItems player];
 private _board={
  [_this select 0,_this select 1] remoteExecCall ["DSDS_fnc_boardSupportPassenger",owner (_this select 0)];
  private _until=diag_tickTime+5;waitUntil {sleep 0.05;vehicle (_this select 0)==(_this select 1) || {diag_tickTime>_until}};
  vehicle (_this select 0)==(_this select 1)
 };
 [[player,_plane] call _board,"owner-local cargo boarding succeeds"] call _assert;
 private _bad=[player,_plane,_start,"DSDS_TEST_MISSING_PARACHUTE"] call DSDS_fnc_confirmPassengerJump;
 [!_bad,"missing parachute produces failure, not fulfilled delivery"] call _assert;
 sleep 0.2;
 [alive player && {vehicle player==player} && {player distance _start<2},"failed spawn returns traveller alive to departure"] call _assert;
 [isDamageAllowed player,"failed handoff restores original damage setting"] call _assert;
 private _dsdsAuthorizedPlayer=player;[player,-350] call DSDS_fnc_changeWallet;
 DSDS_jobs set ["fail49",createHashMapFromArray [["state","paid"],["holder",player],["player",player],["cost",350]]];
 ["fail49",false,"test handoff failure"] call DSDS_fnc_finishSupportContract;
 [player getVariable ["moneyX",0]==1000,"failed handoff refund restores exact350"] call _assert;
 ["fail49",false] call DSDS_fnc_finishSupportContract;
 [player getVariable ["moneyX",0]==1000,"repeated completion cannot double refund"] call _assert;
 [[player,_plane] call _board,"second cargo boarding succeeds"] call _assert;
 private _ok=[player,_plane,_start] call DSDS_fnc_confirmPassengerJump;
 [_ok,"server confirms matching owner outcome and actual parachute occupancy"] call _assert;
 [vehicle player isKindOf "ParachuteBase" && {driver vehicle player==player},"traveller occupies driver seat of deployed parachute"] call _assert;
 private _chute=vehicle player;
 sleep 1.5;
 [isDamageAllowed player,"handoff protection ends after confirmed deployment"] call _assert;
 [([backpack player,backpackItems player]) isEqualTo _bag,"backpack and contents preserved"] call _assert;
 private _until=diag_tickTime+160;
 waitUntil {sleep 0.2;!alive player || {vehicle player==player && {getPosATL player select 2<2}} || {diag_tickTime>_until}};
 [alive player && {vehicle player==player} && {getPosATL player select 2<2},"natural descent lands traveller alive without early two-metre ejection"] call _assert;
 [damage player<0.1,"landing causes no significant fall damage"] call _assert;
 sleep 2;
 [isNull _chute,"parachute removed after landing"] call _assert;
 [[player,_plane] call _board,"cargo boarding before free-fall recovery test"] call _assert;
 unassignVehicle player;moveOut player;player setPosATL (_start vectorAdd [0,0,100]);
 private _rescued=[player,_plane,_start] call DSDS_fnc_confirmPassengerJump;
 [_rescued && {alive player} && {vehicle player isKindOf "ParachuteBase"},"already-airborne traveller receives a verified rescue parachute"] call _assert;
 sleep 1.5;
 player allowDamage false;unassignVehicle player;moveOut player;player setPosATL _start;player setVelocity [0,0,0];player allowDamage true;
 deleteVehicle _plane;deleteVehicle _npc;deleteGroup _g;
 diag_log format ["[PARACHUTE49] DONE %1 passes, %2 failures",_pass,_fail];
};
