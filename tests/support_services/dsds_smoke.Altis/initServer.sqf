 {
  [!isNil (getText (_x >> "handler")),"debug handler "+configName _x] call _assert;
 } forEach ("true" configClasses (configFile >> "DSDS_DebugMissions"));
 private _mystic=[[14500,16500,0],0] call DSDS_fnc_mysticSpawn;
 [!isNull _mystic && {alive _mystic},"Mystic spawn helper creates live NPC"] call _assert;
 [!isObjectHidden _mystic && {simulationEnabled _mystic},"Mystic visible and simulation enabled"] call _assert;
 [abs ((getPosATL _mystic) select 2)<1,"Mystic grounded above terrain"] call _assert;
 private _mg=group _mystic;deleteVehicle _mystic;deleteGroup _mg;
 deleteVehicle _u;deleteGroup _g;
