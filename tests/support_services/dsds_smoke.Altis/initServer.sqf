 private _car=createVehicle ["C_Offroad_01_F",[14600,16500,0],[],0,"NONE"];
 _car setVariable ["DSDS_purchasePaid",700];
 [[_car] call DSDS_fnc_vehicleValue<=700,"resale respects recorded purchase amount"] call _assert;
