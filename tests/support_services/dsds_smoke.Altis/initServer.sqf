 [[resistance],"smoke_task",["Smoke","Smoke",""],getPosATL _box,false,0,false] call BIS_fnc_taskCreate;
 DSDS_activeStash=_record;
 [!([_record] call DSDS_fnc_cleanupContrabandStash),"stocked guarded stash retained"] call _assert;
 clearItemCargoGlobal _box;
 [[_record] call DSDS_fnc_cleanupContrabandStash,"empty stash retired"] call _assert;
 sleep 0.1;
 [isNull _box,"empty container deleted"] call _assert;
 [getMarkerColor _marker=="","stash marker removed"] call _assert;
 [count DSDS_activeStash==0,"active stash released"] call _assert;
 private _isotopeIndex=["DSDS_IndustrialIsotopes"] call jn_fnc_arsenal_itemType;
 jna_dataList=[];for "_i" from 0 to 26 do {jna_dataList pushBack [];};
