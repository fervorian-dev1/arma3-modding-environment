[] spawn {
    sleep 3;
    DSDS_testFailures=0;
    private _assert={params ["_ok","_name"];if (!_ok) then {DSDS_testFailures=DSDS_testFailures+1;};diag_log format ["[DSDS RAID TEST] %1: %2",["FAIL","PASS"] select _ok,_name];};
    {
        private _category=_x;
        {
            private _file=getText (_category >> "file") + "\fn_" + configName _x + ".sqf";
            compile preprocessFileLineNumbers _file;
            [!isNil ("DSDS_fnc_" + configName _x),"registered " + configName _x] call _assert;
        } forEach ("true" configClasses _category);
    } forEach ("true" configClasses (configFile >> "CfgFunctions" >> "DSDS"));
    teamPlayer=resistance; Occupants=west; Invaders=east; tierWar=1;
    // Isolated fixture diplomacy only. Production never changes side relationships.
    west setFriend [resistance,0]; resistance setFriend [west,0];
    A3A_enabledDLC=[]; A3A_hasACE=false; A3A_hasACEMedical=false;
    // Ultimate's native template loader reads the campaign's generation setting.
    loadoutsToGenerate=5;
    private _logicGroup=createGroup sideLogic;
    A3A_customUnitTypes=_logicGroup createUnit ["Logic",[0,0,0],[],0,"NONE"];
    private _faction=[["\x\A3A\addons\core\Templates\Templates\FactionDefaults\EnemyDefaults.sqf","\x\A3A\addons\core\Templates\Templates\3CBF\3CBF_AI_AAF.sqf"]] call A3A_fnc_loadFaction;
    [_faction,"occ"] call A3A_fnc_compileGroups;
    { ["loadouts_occ_"+_x,_y+["B_G_Soldier_F"]] call A3A_fnc_registerUnitType; } forEach (_faction get "loadouts");
    A3A_faction_occ=_faction;
    [count _faction>0,"actual installed 3CB AAF template loaded without campaign"] call _assert;
    private _savedFaction=str _faction;
    airportsX=[]; bigAttackInProgress=false;
    sidesX=_logicGroup createUnit ["Logic",[0,0,0],[],0,"NONE"];
    sidesX setVariable ["test_airfield",east];
    createMarker ["test_airfield",[2000,2000,0]]; "test_airfield" setMarkerColor "ColorEAST";
    private _hqGroup=createGroup resistance;
    petros=_hqGroup createUnit ["I_G_Soldier_F",[4000,4000,0],[],0,"NONE"];
    petros allowDamage false; petros disableAI "PATH"; removeAllWeapons petros;
    private _actor=_hqGroup createUnit ["I_G_Soldier_F",[4002,4000,0],[],0,"NONE"];
    _actor allowDamage false; _actor hideObjectGlobal true;
    serverInitDone=true;
    DSDS_raidConfig set ["responseDelay",900]; DSDS_raidConfig set ["responseRandom",0];
    DSDS_raidConfig set ["recovery",2]; DSDS_raidConfig set ["cleanupDelay",1];
    DSDS_raidConfig set ["approachDistance",1600]; DSDS_raidConfig set ["assaultTimeout",600];
    DSDS_raidConfig set ["decayPerSecond",0];
    [] call DSDS_fnc_tickHQNoise;
    private _score=DSDS_noise get "score";
    [_actor,[["B_556x45_Ball","",[4000,4000,0],50,"shot"]]] call DSDS_fnc_reportHQNoise;
    [DSDS_noise get "score"==_score,"public reporter rejects non-player AI"] call _assert;
    private _dsdsNoiseAuthorizedUnit=_actor;
    [["B_556x45_Ball"] call DSDS_fnc_noiseWeight==1,"rifle ammunition produces ordinary noise"] call _assert;
    [["B_556x45_Ball","muzzle_snds_M"] call DSDS_fnc_noiseWeight<1,"real suppressor reduces noise weight"] call _assert;
    [["SmokeShell"] call DSDS_fnc_noiseWeight==0,"smoke does not count as an explosion"] call _assert;
    [["GrenadeHand","","explosion"] call DSDS_fnc_noiseWeight>10,"explosive detonation receives heavier weight"] call _assert;
    [!([_actor,[4400,4000,0],100] call DSDS_fnc_applyHQNoise),"noise beyond 300 m is ignored"] call _assert;
    bigAttackInProgress=true;
    [!([_actor,[4002,4000,0],100] call DSDS_fnc_applyHQNoise),"defending a native major attack does not build raid suspicion"] call _assert;
    bigAttackInProgress=false;
    [[_actor,[4002,4000,0],20] call DSDS_fnc_applyHQNoise,"nearby authorized noise accumulates"] call _assert;
    DSDS_raidConfig set ["decayPerSecond",1]; DSDS_noise set ["lastTick",diag_tickTime-5]; [] call DSDS_fnc_tickHQNoise;
    [DSDS_noise get "score"<20,"quiet time decays accumulated suspicion"] call _assert;
    DSDS_raidConfig set ["decayPerSecond",0];
    // Tier planning uses real transport classes and custom native loadout IDs.
    {
        _x params ["_war","_min","_max","_vmin","_vmax"];
        private _plan=[[4000,4000,0],_war] call DSDS_fnc_planHQRaid;
        [count _plan>0 && {_plan get "men">=_min} && {_plan get "men"<=_max},format ["war %1 infantry scale",_war]] call _assert;
        [count (_plan get "ground")>=_vmin && {count (_plan get "ground")<=_vmax},format ["war %1 light vehicle scale",_war]] call _assert;
        [((_plan get "flights") findIf {(_x select 1) distance2D [4000,4000,0]<800 || {(_x select 1) distance2D [4000,4000,0]>1200}})<0,"landing zones stay 800–1200 m away"] call _assert;
        [((_plan get "flights") findIf {!((_x select 0) in ((_faction get "vehiclesHelisTransport")+(_faction get "vehiclesHelisLight")))})<0,"all transports come from selected occupier template"] call _assert;
    } forEach [[1,20,25,1,2],[5,30,35,2,3],[10,40,50,3,5]];
    [_actor,[4002,4000,0],300] call DSDS_fnc_applyHQNoise; [] call DSDS_fnc_tickHQNoise;
    [DSDS_noise get "phase"=="preparing" && {DSDS_noise get "score"==0},"threshold reserves one raid and consumes noise"] call _assert;
    [!([_actor,[4002,4000,0],300] call DSDS_fnc_applyHQNoise),"preparation noise cannot queue another raid"] call _assert;
    bigAttackInProgress=true; DSDS_noise set ["dueAt",diag_tickTime-1]; [] call DSDS_fnc_tickHQNoise;
    [DSDS_noise get "phase"=="preparing","native major attack defers custom launch"] call _assert;
    bigAttackInProgress=false; [] call DSDS_fnc_tickHQNoise;
    private _generation=DSDS_noise get "generation";
    [] call DSDS_fnc_tickHQNoise;
    [DSDS_noise get "generation"==_generation && {DSDS_noise get "phase"=="active"},"active raid cannot duplicate spawn"] call _assert;
    [!([_actor,[4002,4000,0],300] call DSDS_fnc_applyHQNoise),"battle noise is discarded rather than banked"] call _assert;
    private _raid=DSDS_noise get "raid";
    private _deadline=diag_tickTime+360;
    waitUntil {sleep 2; _raid getOrDefault ["spawnComplete",false] || {_raid get "ended"} || {diag_tickTime>_deadline}};
    [count (_raid get "infantry")>=20 && {count (_raid get "infantry")<=25},"actual raid creates 20–25 airborne troops"] call _assert;
    [((_raid get "units") findIf {side group _x!=Occupants})<0,"every raid unit belongs to occupying side"] call _assert;
    [((_raid get "infantry") findIf {(_x getVariable ["unitType",""]) find "loadouts_occ_"!=0})<0,"infantry use native custom faction loadouts"] call _assert;
    waitUntil {sleep 2; _raid get "landingsDone">=_raid get "landingsTotal" || {_raid get "ended"} || {diag_tickTime>_deadline}};
    private _helis=(_raid get "vehicles") select {_x isKindOf "Helicopter"};
    [{_x getVariable ["DSDS_raidLanded",false]} count _helis==count _helis && {count _helis>0},"real AI helicopters land and unload"] call _assert;
    private _foot=(_raid get "infantry") select {alive _x && {vehicle _x==_x}};
    [count _foot>=20,"airborne infantry actually dismount on the ground"] call _assert;
    private _before=if (_foot isEqualTo []) then {0} else {(_foot select 0) distance2D [4000,4000,0]};
    sleep 20;
    [!(_foot isEqualTo []) && {(_foot select 0) distance2D [4000,4000,0]<_before-10},"dismounted infantry march toward HQ"] call _assert;
    // Exercise normal defeat completion without triggering campaign kill/reward machinery.
    { _x setVariable ["ACE_isUnconscious",true]; } forEach (_raid get "infantry");
    private _captured=(_raid get "vehicles") select 0; _captured setVariable ["ownerX","TEST_CAPTURED"];
    private _protected=(_raid get "infantry") select 0; _protected setCaptive true;
    _deadline=diag_tickTime+15;
    waitUntil {sleep 1; _raid get "ended" || {diag_tickTime>_deadline}};
    [_raid get "ended","defeated raid ends and orders retreat"] call _assert;
    private _freshGeneration=DSDS_noise get "generation";
    sleep 5;
    [] call DSDS_fnc_tickHQNoise;
    [DSDS_noise get "phase"=="quiet" && {DSDS_noise get "score"==0} && {DSDS_noise get "generation"==_freshGeneration},"finished raid stays quiet without fresh noise"] call _assert;
    [!isNull _captured && {!isNull _protected},"cleanup preserves captured vehicle and captive"] call _assert;
    [!([_raid,"duplicate"] call DSDS_fnc_endHQRaid),"raid completion is idempotent"] call _assert;
    [_actor,[4002,4000,0],301] call DSDS_fnc_applyHQNoise; [] call DSDS_fnc_tickHQNoise;
    [DSDS_noise get "phase"=="preparing","fresh post-raid noise can trigger another preparation"] call _assert;
    DSDS_noise set ["dueAt",diag_tickTime+900];
    petros setPosATL [4100,4000,0]; [] call DSDS_fnc_tickHQNoise;
    [DSDS_noise get "phase"=="quiet" && {DSDS_noise get "score"==0},"HQ relocation discards stale suspicion/preparation"] call _assert;
    [str _faction==_savedFaction && {sidesX getVariable "test_airfield"==east} && {markerColor "test_airfield"=="ColorEAST"},"faction templates and airfield ownership/marker remain unchanged"] call _assert;
    diag_log format ["[DSDS RAID TEST] COMPLETE failures=%1",DSDS_testFailures];
};
