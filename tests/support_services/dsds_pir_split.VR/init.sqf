 diag_log format ["[PIR SPLIT HEALTH] afterWake=%1 afterMonitor=%2 damageAllowed=%3",_postWakeDamage,damage _u,isDamageAllowed _u];
 [abs(damage _u-_postWakeDamage)<.01 && {isDamageAllowed _u},"recovery UI repair does not heal or make player invulnerable"] call _assert;
